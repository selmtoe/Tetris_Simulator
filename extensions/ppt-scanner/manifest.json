{
  "manifest_version": 3,
  "name": "PPT Scanner for Tetris Lab",
  "version": "1.1.0",
  "description": "Scans PPT board from YouTube videos and embeds.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
