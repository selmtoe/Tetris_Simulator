{
  "manifest_version": 3,
  "name": "PPT Scanner for Tetris Lab",
  "version": "1.2.1",
  "description": "YouTubeのぷよテトの局面を画像からシミュレータへ取り込みます。",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {"default_title": "この動画の局面をシミュレータへ送る"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": false
  }]
}
